{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soma Amp",
  "identifier": "ru.deemmoor.somaamp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Soma Amp",
        "width": 508,
        "height": 900,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "deemmoor",
    "shortDescription": "Плеер радио SomaFM",
    "longDescription": "Soma Amp — десктопный плеер радио SomaFM",
    "copyright": "© 2026 deemmoor",
    "category": "Music",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      },
      "wix": {
        "language": "ru-RU"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMEIyMDU1MTA3NEI5MTMKUldRVHVYUVFWU0FMYTFQKzVlS2VPQzg2V1ZsR2JZcStPbVkwdWlneGlYVXpwTk1RMWJkUnNoMU0K",
      "endpoints": [
        "https://github.com/DeemMoor/soma-amp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

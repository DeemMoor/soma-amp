{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "localhost",
  "description": "те же права, что в default.json, но для страницы с http://127.0.0.1:1430 — так плеер открывается в установленной программе (плагин tauri-plugin-localhost)",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:1430"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "allow-system-action",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-settings-set",
    "allow-settings-import",
    "allow-open-url"
  ]
}
